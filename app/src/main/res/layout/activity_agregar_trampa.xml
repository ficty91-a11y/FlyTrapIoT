<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla "Nueva trampa" (CREAR). ScrollView para que se pueda desplazar con el teclado abierto -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".AgregarTrampaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Nueva trampa"
            android:textColor="?attr/colorPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Código de sector" />

        <EditText
            android:id="@+id/etCodigoSector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: SEC-01"
            android:inputType="textCapCharacters"
            android:maxLength="20"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tipo de trampa" />

        <Spinner
            android:id="@+id/spTipoTrampa"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nivel de captura (N° de moscas)" />

        <EditText
            android:id="@+id/etNivelCaptura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 0"
            android:inputType="number"
            android:maxLength="4"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Observaciones (opcional)" />

        <EditText
            android:id="@+id/etObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Ej: cebo cambiado"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Guardar trampa" />
    </LinearLayout>
</ScrollView>